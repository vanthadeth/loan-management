{
  // Type checking only (npm run typecheck). Shared files in ../src resolve packages from this app's
  // node_modules, as Metro does; tsconfig.json itself cannot map them because Metro reads its paths.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  }
}
